# Binaries and executables
*.exe

# Memory images and symbol tables (too large for git)
*.raw
*.lime
*.mem
*.vmem
*.json.xz
symbols/*
!symbols/.gitkeep

# Trained models and generated output
baseline/models/*
!baseline/models/.gitkeep
eval/results/*
!eval/results/.gitkeep
!eval/results/metrics.json
!eval/results/clean_jit.json
!eval/results/clean_jit.html
!eval/results/infected_both.json
!eval/results/infected_both.html
!eval/results/chkrootkit_live_output.txt
!eval/results/userland_malware.json
!eval/results/userland_malware.html
report*.json
report*.html

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
